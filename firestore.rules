rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    // Validation blueprint for Watchlist item
    function isValidWatchlistItem(data) {
      return data.keys().hasAll(['id', 'type', 'title', 'poster', 'backdrop', 'rating', 'year', 'genres', 'addedAt'])
        && data.keys().size() == 9
        && data.id is int
        && data.type is string && (data.type == 'movie' || data.type == 'tv')
        && data.title is string && data.title.size() <= 200
        && (data.poster == null || (data.poster is string && data.poster.size() <= 1000))
        && (data.backdrop == null || (data.backdrop is string && data.backdrop.size() <= 1000))
        && (data.rating is int || data.rating is float)
        && data.year is string && data.year.size() <= 10
        && data.genres is list
        && data.genres.size() <= 20
        && (data.genres.size() == 0 || data.genres[0] is string)
        && data.addedAt is timestamp;
    }

    function isValidContinueWatchingItem(data) {
      return data.keys().hasAll(['id', 'type', 'title', 'poster', 'backdrop', 'rating', 'year', 'genres', 'progress', 'updatedAt'])
        && data.id is int
        && data.type is string && (data.type == 'movie' || data.type == 'tv')
        && data.title is string && data.title.size() <= 200
        && (data.poster == null || (data.poster is string && data.poster.size() <= 1000))
        && (data.backdrop == null || (data.backdrop is string && data.backdrop.size() <= 1000))
        && (data.rating is int || data.rating is float)
        && data.year is string && data.year.size() <= 10
        && data.genres is list
        && data.genres.size() <= 20
        && (data.progress is int || data.progress is float)
        && data.progress >= 0 && data.progress <= 100
        && data.updatedAt is timestamp
        && (
          data.keys().size() == 10
          || (
            data.keys().size() == 14
            && data.keys().hasAll(['positionSeconds', 'durationSeconds', 'season', 'episode'])
            && (data.positionSeconds is int || data.positionSeconds is float)
            && data.positionSeconds >= 0
            && (data.durationSeconds is int || data.durationSeconds is float)
            && data.durationSeconds > 0
            && data.positionSeconds <= data.durationSeconds
            && data.season is int && data.season >= 0
            && data.episode is int && data.episode >= 0
          )
      );
    }

    function isValidViewingHistoryItem(data) {
      return data.keys().hasAll([
          'id', 'type', 'title', 'poster', 'backdrop', 'rating', 'year', 'genres',
          'progress', 'positionSeconds', 'durationSeconds', 'season', 'episode',
          'completed', 'watchCount', 'lastWatchedAt'
        ])
        && data.keys().size() == 16
        && data.id is int
        && data.type is string && (data.type == 'movie' || data.type == 'tv')
        && data.title is string && data.title.size() <= 200
        && data.poster is string && data.poster.size() <= 1000
        && data.backdrop is string && data.backdrop.size() <= 1000
        && (data.rating is int || data.rating is float)
        && data.year is string && data.year.size() <= 10
        && data.genres is list && data.genres.size() <= 20
        && (data.progress is int || data.progress is float)
        && data.progress >= 0 && data.progress <= 100
        && (data.positionSeconds is int || data.positionSeconds is float)
        && data.positionSeconds >= 0
        && (data.durationSeconds is int || data.durationSeconds is float)
        && data.durationSeconds > 0
        && data.positionSeconds <= data.durationSeconds
        && data.season is int && data.season >= 0
        && data.episode is int && data.episode >= 0
        && data.completed is bool
        && data.watchCount is int && data.watchCount >= 1
        && data.lastWatchedAt is timestamp;
    }

    function isValidTitlePreference(data) {
      return data.keys().hasAll(['id', 'type', 'value', 'updatedAt'])
        && data.keys().size() == 4
        && data.id is int
        && data.type is string && (data.type == 'movie' || data.type == 'tv')
        && data.value is string && (data.value == 'like' || data.value == 'dislike')
        && data.updatedAt is timestamp;
    }

    function titlePreferencePath(itemId) {
      return /databases/$(database)/documents/users/$(request.auth.uid)/titlePreferences/$(itemId);
    }

    function titleReactionPath(itemId) {
      return /databases/$(database)/documents/titleReactions/$(itemId);
    }

    function previousTitlePreference(itemId) {
      return exists(titlePreferencePath(itemId))
        ? get(titlePreferencePath(itemId)).data.value
        : 'none';
    }

    function nextTitlePreference(itemId) {
      return existsAfter(titlePreferencePath(itemId))
        ? getAfter(titlePreferencePath(itemId)).data.value
        : 'none';
    }

    function reactionDelta(itemId, value) {
      return (nextTitlePreference(itemId) == value ? 1 : 0)
        - (previousTitlePreference(itemId) == value ? 1 : 0);
    }

    function reactionWasUpdated(itemId) {
      return existsAfter(titleReactionPath(itemId))
        && getAfter(titleReactionPath(itemId)).data.updatedAt == request.time;
    }

    function isValidTitleReaction(data) {
      return data.keys().hasAll(['id', 'type', 'likes', 'dislikes', 'updatedAt'])
        && data.keys().size() == 5
        && data.id is int
        && data.type is string && (data.type == 'movie' || data.type == 'tv')
        && data.likes is int && data.likes >= 0
        && data.dislikes is int && data.dislikes >= 0
        && data.updatedAt is timestamp;
    }

    function isValidPlaybackSettings(data) {
      return data.keys().hasAll(['autoplayNext', 'subtitleSize', 'subtitleOffset', 'updatedAt'])
        && data.keys().size() == 4
        && data.autoplayNext is bool
        && (data.subtitleSize is int || data.subtitleSize is float)
        && data.subtitleSize >= 50 && data.subtitleSize <= 250
        && (data.subtitleOffset is int || data.subtitleOffset is float)
        && data.subtitleOffset >= -10 && data.subtitleOffset <= 10
        && data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /watchlist/{itemId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidWatchlistItem(incoming());
      }

      match /continueWatching/{itemId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidContinueWatchingItem(incoming());
      }

      match /viewingHistory/{itemId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && isValidViewingHistoryItem(incoming());
      }

      match /titlePreferences/{itemId} {
        allow read: if isOwner(userId);
        allow delete: if isOwner(userId)
          && reactionWasUpdated(itemId);
        allow create, update: if isOwner(userId)
          && isValidTitlePreference(incoming())
          && reactionWasUpdated(itemId);
      }

      match /settings/{settingsId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && settingsId == 'playback'
          && isValidPlaybackSettings(incoming());
        allow delete: if isOwner(userId);
      }
    }

    // Public aggregate counters. A signed-in user can only change the exact
    // delta caused by their own preference in the same atomic transaction.
    match /titleReactions/{itemId} {
      allow read: if true;
      allow create: if isSignedIn()
        && isValidTitleReaction(incoming())
        && incoming().likes == (nextTitlePreference(itemId) == 'like' ? 1 : 0)
        && incoming().dislikes == (nextTitlePreference(itemId) == 'dislike' ? 1 : 0)
        && (
          (
            existsAfter(titlePreferencePath(itemId))
            && getAfter(titlePreferencePath(itemId)).data.id == incoming().id
            && getAfter(titlePreferencePath(itemId)).data.type == incoming().type
          )
          || (
            !existsAfter(titlePreferencePath(itemId))
            && exists(titlePreferencePath(itemId))
            && get(titlePreferencePath(itemId)).data.id == incoming().id
            && get(titlePreferencePath(itemId)).data.type == incoming().type
          )
        );
      allow update: if isSignedIn()
        && isValidTitleReaction(incoming())
        && incoming().id == resource.data.id
        && incoming().type == resource.data.type
        && incoming().likes == resource.data.likes + reactionDelta(itemId, 'like')
        && incoming().dislikes == resource.data.dislikes + reactionDelta(itemId, 'dislike');
    }

    // Public site content. Everyone can read the catalogue configuration,
    // but only the authenticated owner account can change it.
    match /site_config/{configId} {
      allow read: if true;
      allow write: if isSignedIn()
        && request.auth.token.email == 'ahmedabdghaney@gmail.com';
    }

    // Watch-party room settings (member limit + visibility). Anyone with the
    // code can read a room; only public rooms can be listed. Only the signed-in
    // host can create, refresh, or close their room.
    function isValidWatchRoom(data, code) {
      return data.keys().hasOnly([
          'code', 'hostUid', 'hostName', 'type', 'tmdbId', 'title',
          'maxMembers', 'visibility', 'memberCount', 'createdAtMs', 'updatedAtMs'
        ])
        && data.keys().size() == 11
        && data.code == code
        && code.matches('^NOIR-[0-9]{4}$')
        && data.hostUid == request.auth.uid
        && data.hostName is string && data.hostName.size() <= 60
        && (data.type == 'movie' || data.type == 'tv')
        && data.tmdbId is int
        && data.title is string && data.title.size() <= 200
        && data.maxMembers is int && data.maxMembers >= 2 && data.maxMembers <= 20
        && (data.visibility == 'private' || data.visibility == 'public')
        && data.memberCount is int && data.memberCount >= 0 && data.memberCount <= 50
        && data.createdAtMs is int
        && data.updatedAtMs is int;
    }

    match /watchRooms/{code} {
      allow get: if true;
      allow list: if resource.data.visibility == 'public';
      allow create: if isSignedIn() && isValidWatchRoom(incoming(), code);
      allow update: if isSignedIn()
        && resource.data.hostUid == request.auth.uid
        && incoming().diff(resource.data).affectedKeys().hasOnly(['memberCount', 'updatedAtMs', 'playback', 'hostTime', 'hostTimeAtMs'])
        && incoming().memberCount is int && incoming().memberCount >= 0 && incoming().memberCount <= 50
        && incoming().updatedAtMs is int
        && (!('hostTime' in incoming()) || incoming().hostTime is number)
        && (!('hostTimeAtMs' in incoming()) || incoming().hostTimeAtMs is int)
        && (!('playback' in incoming()) || (
          incoming().playback.keys().hasOnly(['action', 'time', 'byUid', 'byName', 'atMs'])
          && incoming().playback.action in ['play', 'pause', 'seek']
          && incoming().playback.time is number
          && incoming().playback.byUid == request.auth.uid
          && incoming().playback.byName is string && incoming().playback.byName.size() <= 60
          && incoming().playback.atMs is int
        ));
      allow delete: if isSignedIn() && resource.data.hostUid == request.auth.uid;

      // Presence: each signed-in member writes only their own heartbeat.
      match /members/{memberId} {
        allow read: if isSignedIn();
        allow create, update: if isOwner(memberId)
          && exists(/databases/$(database)/documents/watchRooms/$(code))
          && incoming().keys().hasOnly(['name', 'joinedAtMs', 'lastSeenMs'])
          && incoming().name is string && incoming().name.size() <= 60
          && incoming().joinedAtMs is int
          && incoming().lastSeenMs is int;
        allow delete: if isOwner(memberId)
          || (isSignedIn() && get(/databases/$(database)/documents/watchRooms/$(code)).data.hostUid == request.auth.uid);
      }

      // Chat: signed-in members post as themselves; messages are never edited.
      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && exists(/databases/$(database)/documents/watchRooms/$(code))
          && incoming().keys().hasOnly(['uid', 'name', 'text', 'atMs'])
          && incoming().uid == request.auth.uid
          && incoming().name is string && incoming().name.size() <= 60
          && incoming().text is string && incoming().text.size() >= 1 && incoming().text.size() <= 500
          && incoming().atMs is int;
      }
    }
  }
}
