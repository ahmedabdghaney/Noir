{
  "rules": {
    ".read": false,
    ".write": false,
    "watchParty": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('hostUid').val() === auth.uid) && (!newData.exists() || newData.child('hostUid').val() === auth.uid)",
        "hostUid": { ".validate": "newData.isString() && newData.val() === auth.uid" },
        "hostTime": { ".validate": "newData.isNumber() && newData.val() >= 0" },
        "hostTimeAtMs": { ".validate": "newData.isNumber()" },
        "playback": {
          ".validate": "newData.hasChildren(['action', 'time', 'byUid', 'byName', 'atMs'])",
          "action": { ".validate": "newData.val() === 'play' || newData.val() === 'pause' || newData.val() === 'seek'" },
          "time": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "byUid": { ".validate": "newData.val() === auth.uid" },
          "byName": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "atMs": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        },
        "$other": { ".validate": false }
      }
    }
  }
}
